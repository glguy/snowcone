{
    "version": 6,
    "configurePresets": [
        {
            "name": "sanitize",
            "hidden": true,
            "description": "ASan and UBSan; the build tree is for testing, not installing",
            "cacheVariables": {
                "SNOWCONE_SANITIZE": "ON"
            }
        },
        {
            "name": "linux",
            "description": "Configure for Debian Bookworm",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On"
            }
        },
        {
            "name": "arm-mac",
            "displayName": "",
            "description": "Configure for Apple Silicon macOS",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On"
            },
            "environment": {
                "PKG_CONFIG_PATH": "/opt/homebrew/opt/ncurses/lib/pkgconfig:/opt/homebrew/opt/libarchive/lib/pkgconfig"
            }
        },
        {
            "name": "intel-mac",
            "displayName": "",
            "description": "Configure for x86_64 macOS",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "On"
            },
            "environment": {
                "PKG_CONFIG_PATH": "/usr/local/opt/ncurses/lib/pkgconfig:/usr/local/opt/libarchive/lib/pkgconfig"
            }
        },
        {
            "name": "linux-asan",
            "description": "Debian with ASan and UBSan",
            "inherits": [
                "sanitize",
                "linux"
            ]
        },
        {
            "name": "arm-mac-asan",
            "description": "Apple Silicon macOS with ASan and UBSan",
            "inherits": [
                "sanitize",
                "arm-mac"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "linux",
            "configurePreset": "linux"
        },
        {
            "name": "arm-mac",
            "configurePreset": "arm-mac"
        },
        {
            "name": "intel-mac",
            "configurePreset": "intel-mac"
        },
        {
            "name": "linux-asan",
            "configurePreset": "linux-asan"
        },
        {
            "name": "arm-mac-asan",
            "configurePreset": "arm-mac-asan"
        }
    ],
    "testPresets": [
        {
            "name": "linux",
            "configurePreset": "linux"
        },
        {
            "name": "arm-mac",
            "configurePreset": "arm-mac"
        },
        {
            "name": "intel-mac",
            "configurePreset": "intel-mac"
        },
        {
            "name": "linux-asan",
            "configurePreset": "linux-asan",
            "environment": {
                "UBSAN_OPTIONS": "print_stacktrace=1"
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "arm-mac-asan",
            "configurePreset": "arm-mac-asan",
            "environment": {
                "UBSAN_OPTIONS": "print_stacktrace=1"
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
